  <div id="pub-methode" class="page">
    <div style="background:var(--s2);padding:12px 24px;border-bottom:1px solid var(--border);cursor:pointer" onclick="showPublicPage('home')"><span style="color:var(--muted);font-size:13px">← Retour</span></div>
    <div style="padding:32px 24px;max-width:720px;margin:0 auto">

      <!-- TITRE -->
      <div style="text-align:center;margin-bottom:40px">
        <div style="font-family:Bebas Neue,sans-serif;font-size:42px;letter-spacing:3px;color:var(--text);line-height:1;margin-bottom:8px">Ma <em style="color:var(--gold-l);font-style:normal">Méthode</em></div>
        <p style="font-size:15px;color:var(--muted);max-width:480px;margin:0 auto">Comment je construis chaque pronostic publié sur PronoSkillz — de l'analyse à la validation.</p>
      </div>

      <!-- 5 QUESTIONS -->
      <div style="background:var(--s1);border:1px solid var(--border);border-radius:14px;padding:28px;margin-bottom:24px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
          <div style="background:var(--gold);color:#000;font-family:Bebas Neue,sans-serif;font-size:32px;width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">5</div>
          <div>
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;letter-spacing:1px;color:var(--gold-l)">Les 5 questions obligatoires</div>
            <div style="font-size:13px;color:var(--muted)">Je me pose ces questions AVANT de valider chaque pronostic</div>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:12px">

          <div style="background:var(--s2);border:1px solid var(--border);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start">
            <div style="background:var(--gold);color:#000;font-family:Bebas Neue,sans-serif;font-size:20px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">1</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px">Ai-je vraiment analysé le match ?</div>
              <div style="font-size:13px;color:var(--muted);line-height:1.6">Enjeux du match, état de forme des deux équipes, historique des confrontations, actualités récentes (blessures, suspensions, contexte…). Si je n'ai pas répondu à tout ça, le prono ne sort pas.</div>
            </div>
          </div>

          <div style="background:var(--s2);border:1px solid var(--border);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start">
            <div style="background:var(--gold);color:#000;font-family:Bebas Neue,sans-serif;font-size:20px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">2</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px">Mon analyse va-t-elle dans le sens de mon pronostic ?</div>
              <div style="font-size:13px;color:var(--muted);line-height:1.6">Le pronostic doit découler naturellement de l'analyse, pas l'inverse. Si je dois forcer l'interprétation pour justifier mon choix, c'est non.</div>
            </div>
          </div>

          <div style="background:rgba(192,85,85,.12);border:1px solid rgba(192,85,85,.3);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start">
            <div style="background:#c05555;color:#fff;font-family:Bebas Neue,sans-serif;font-size:20px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">3</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:#f08080;margin-bottom:4px">Est-ce que je supporte l'équipe sur laquelle je pronostique ?</div>
              <div style="font-size:13px;color:var(--muted);line-height:1.6"><strong style="color:#f08080">SI OUI — STOP.</strong> Tu n'es sûrement pas objectif, même si tu le crois. Ce sont des processus cognitifs inconscients qui biaisent ton jugement sans que tu t'en rendes compte. Ce prono ne sort pas.</div>
            </div>
          </div>

          <div style="background:rgba(192,85,85,.12);border:1px solid rgba(192,85,85,.3);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start">
            <div style="background:#c05555;color:#fff;font-family:Bebas Neue,sans-serif;font-size:20px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">4</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:#f08080;margin-bottom:4px">Ce prono est-il là pour rattraper une perte précédente ?</div>
              <div style="font-size:13px;color:var(--muted);line-height:1.6"><strong style="color:#f08080">SI OUI — Arrête.</strong> Tu recherches le gain et tu n'es plus objectif. Le "tilt" est l'ennemi numéro un du parieur. Ce prono ne sort pas.</div>
            </div>
          </div>

          <div style="background:rgba(26,122,60,.12);border:1px solid rgba(26,122,60,.35);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start">
            <div style="background:var(--gl);color:#fff;font-family:Bebas Neue,sans-serif;font-size:20px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">5</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:#6ee89a;margin-bottom:4px">Bravo ! Ton prono est validé — mais sur quel bookmaker la cote est-elle la plus grande ?</div>
              <div style="font-size:13px;color:var(--muted);line-height:1.6">Compare les cotes sur plusieurs bookmakers avant de miser. Parfois il vaut mieux jouer <strong style="color:var(--text)">Nul ET Victoire</strong> séparément plutôt que Double chance — la différence peut être significative sur le long terme.</div>
            </div>
          </div>

        </div>
      </div>

      <!-- 5 REGLES -->
      <div style="background:var(--s1);border:1px solid var(--gold-d);border-radius:14px;padding:28px;margin-bottom:24px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
          <div style="background:var(--gold);color:#000;font-family:Bebas Neue,sans-serif;font-size:32px;width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">★</div>
          <div>
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;letter-spacing:1px;color:var(--gold-l)">Les 5 règles PronoSkillz</div>
            <div style="font-size:13px;color:var(--muted)">Les principes fondamentaux pour parier intelligemment</div>
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:10px">

          <div style="background:var(--s2);border-left:4px solid var(--gold);border-radius:0 10px 10px 0;padding:14px 16px;display:flex;gap:12px;align-items:flex-start">
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:var(--gold-l);flex-shrink:0;width:24px">1</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px">Joue toujours des paris simples</div>
              <div style="font-size:13px;color:var(--muted)">Les combinés font rêver mais les simples font vivre. La régularité sur les paris simples est bien plus rentable sur le long terme.</div>
            </div>
          </div>

          <div style="background:var(--s2);border-left:4px solid var(--gold);border-radius:0 10px 10px 0;padding:14px 16px;display:flex;gap:12px;align-items:flex-start">
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:var(--gold-l);flex-shrink:0;width:24px">2</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px">Ne mise jamais plus de 5% de ta bankroll</div>
              <div style="font-size:13px;color:var(--muted)">Les gains se construisent progressivement. Une belle cote peut booster ta BK mais une mauvaise série ne doit jamais te mettre K.O.</div>
            </div>
          </div>

          <div style="background:var(--s2);border-left:4px solid var(--gold);border-radius:0 10px 10px 0;padding:14px 16px;display:flex;gap:12px;align-items:flex-start">
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:var(--gold-l);flex-shrink:0;width:24px">3</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px">Analyse TOUJOURS tes paris</div>
              <div style="font-size:13px;color:var(--muted)">Pas de feeling, pas de hasard. Chaque pari doit être justifié par une analyse concrète. Si tu ne peux pas l'expliquer, tu ne mises pas.</div>
            </div>
          </div>

          <div style="background:var(--s2);border-left:4px solid var(--gold);border-radius:0 10px 10px 0;padding:14px 16px;display:flex;gap:12px;align-items:flex-start">
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:var(--gold-l);flex-shrink:0;width:24px">4</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px">Pose-toi toujours les 5 questions avant de parier</div>
              <div style="font-size:13px;color:var(--muted)">Elles sont là pour une raison. Chaque question élimine un biais. Ensemble elles protègent ton bankroll et ta lucidité.</div>
            </div>
          </div>

          <div style="background:rgba(192,85,85,.1);border-left:4px solid #c05555;border-radius:0 10px 10px 0;padding:14px 16px;display:flex;gap:12px;align-items:flex-start">
            <div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:#f08080;flex-shrink:0;width:24px">5</div>
            <div>
              <div style="font-size:14px;font-weight:600;color:#f08080;margin-bottom:2px">Respecte les 4 premières règles — sinon ça ne sert à rien</div>
              <div style="font-size:13px;color:var(--muted)">Les règles ne fonctionnent que si tu les appliques systématiquement. Une exception devient vite une habitude.</div>
            </div>
          </div>

        </div>
      </div>

      <!-- CTA -->
      <div style="background:var(--s2);border:1px solid var(--border);border-radius:14px;padding:24px;text-align:center">
        <div style="font-family:Bebas Neue,sans-serif;font-size:24px;letter-spacing:1px;color:var(--gold-l);margin-bottom:8px">Prêt à parier intelligemment ?</div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Accède gratuitement à tous mes pronos analysés selon cette méthode.</p>
        <button class="btn-vip" onclick="showPublicPage('register')" style="padding:12px 28px;font-size:14px">Accès VIP Gratuit ⭐</button>
      </div>

    </div>
  </div>

</div>

<!-- ADMIN LOGIN -->
<div id="admin-login" class="page">
  <div style="background:var(--s1);border-bottom:2px solid var(--gold);padding:0 20px;height:52px;display:flex;align-items:center;justify-content:space-between">
    <div class="admin-logo">PronoSkillz <em>— Administration</em></div>
    <button class="btn-login" onclick="showPage('site-public');showPublicPage('home')">← Retour au site</button>
  </div>
  <div class="login-wrap">
    <div class="login-box">
      <div class="login-logo">Prono<span>Skillz</span></div>
      <div class="login-sub">Espace administration</div>
      <div class="fg" style="text-align:left;margin-bottom:12px"><div class="flabel">Identifiant</div><input class="finput" type="text" id="al-user" placeholder="admin" onkeydown="if(event.key==='Enter')doAdminLogin()" /></div>
      <div class="fg" style="text-align:left;margin-bottom:16px"><div class="flabel">Mot de passe</div><input class="finput" type="password" id="al-pass" placeholder="••••••••" onkeydown="if(event.key==='Enter')doAdminLogin()" /></div>
      <button class="btn-vip" style="width:100%;padding:11px;font-size:14px" onclick="doAdminLogin()">Se connecter</button>
      <div class="login-err" id="al-err">Identifiant ou mot de passe incorrect</div>
    </div>
  </div>
</div>

<!-- ADMIN PANEL -->
<div id="admin-panel" class="page">
  <div class="admin-bar-top">
    <div class="admin-logo">PronoSkillz <em>— Administration</em></div>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="font-size:12px;color:var(--muted)">● Connecté</span>
      <button class="btn-login" onclick="adminLogout()">Déconnexion</button>
      <button class="btn-main" style="font-size:12px;padding:7px 14px" onclick="showPage('site-public');showPublicPage('home')">Voir le site</button>
      <button class="btn-vip" style="font-size:12px;padding:7px 14px" onclick="activerApercuVIP()">👁️ Aperçu VIP</button>
    </div>
  </div>
  <div class="admin-layout">
    <div class="sidebar">
      <div class="si active" onclick="showAPage('dashboard',this)">📊 Tableau de bord</div>
      <div class="si" onclick="showAPage('add-prono',this)">➕ Ajouter un prono</div>
      <div class="si" onclick="showAPage('list-prono',this)">📋 Mes pronos</div>
      <div class="si-sep"></div>
      <div class="si" onclick="showAPage('membres',this)">👥 Membres</div>
      <div class="si-sep"></div>
      <div class="si" onclick="showAPage('reglages',this)">⚙️ Réglages</div>
    </div>
    <div class="amain">

      <div class="apage active" id="apage-dashboard">
        <div class="atitle">Tableau de bord</div>
        <div class="stat-row">
          <div class="scard"><div class="sv" id="dash-total">0</div><div class="sl">Pronos actifs</div></div>
          <div class="scard"><div class="sv" id="dash-vip-count">0</div><div class="sl">Pronos VIP</div></div>
          <div class="scard"><div class="sv" id="dash-membres">—</div><div class="sl">Membres Firebase</div></div>
        </div>
        <div class="acard">
          <div class="acard-h"><span class="acard-t">Derniers pronos</span><button class="abtn abtn-gold abtn-sm" onclick="showAPage('add-prono',document.querySelectorAll('.si')[1])">+ Nouveau</button></div>
          <div style="padding:0"><table class="ptable"><thead><tr><th>Match</th><th>Sport</th><th>Type</th><th>Cote</th></tr></thead><tbody id="dash-tbody"></tbody></table></div>
        </div>
      </div>

      <div class="apage" id="apage-add-prono">
        <div class="atitle">Ajouter un pronostic</div>
        <div class="alert-ok" id="alert-add">✅ Pronostic publié !</div>
        <div class="acard">
          <div class="acard-b">
            <div class="fg2">
              <div class="fg"><div class="flabel">Sport</div><select class="finput" id="f-sport"><option value="foot">⚽ Football</option><option value="tennis">🎾 Tennis</option><option value="autres">🏅 Autres</option></select></div>
              <div class="fg"><div class="flabel">Type</div><select class="finput" id="f-type"><option value="safe">✅ Cote Safe — Public</option><option value="hot">🔥 Grosse Cote — Public</option><option value="vip-safe">✅ Cote Safe — VIP</option><option value="vip-hot">🔥 Grosse Cote — VIP</option></select></div>
              <div class="fg full"><div class="flabel">Match</div><input class="finput" type="text" id="f-match" placeholder="Ex : PSG — Manchester City" /></div>
              <div class="fg"><div class="flabel">Compétition & date</div><input class="finput" type="text" id="f-meta" placeholder="Ex : Ligue des Champions · 21h00" /></div>
              <div class="fg"><div class="flabel">Cote</div><input class="finput" type="number" id="f-cote" placeholder="Ex : 3.40" step="0.01" min="1.01" /></div>
              <div class="fg full"><div class="flabel">Conseil</div><input class="finput" type="text" id="f-conseil" placeholder="Ex : Victoire PSG + plus de 2.5 buts" /></div>
              <div class="fg full"><div class="flabel">Analyse</div><textarea class="finput" id="f-analyse" placeholder="Ex : PSG en grande forme, Man City affaibli par les blessures..." style="min-height:70px"></textarea></div>
              <div class="fg"><div class="flabel">Confiance</div><select class="finput" id="f-confiance"><option value="1% BK">1% BK</option><option value="2% BK">2% BK</option><option value="3% BK" selected>3% BK</option><option value="4% BK">4% BK</option><option value="5% BK">5% BK</option><option value="HORS BK">HORS BK</option></select></div>
            </div>
            <div style="display:flex;gap:10px;margin-top:16px">
              <button class="abtn abtn-green" id="btn-save-prono" onclick="savePronoFirebase()">Publier dans Firebase</button>
              <button class="abtn abtn-ghost" onclick="clearForm()">Effacer</button>
            </div>
          </div>
        </div>
      </div>

      <div class="apage" id="apage-list-prono">
        <div class="atitle">Mes pronostics</div>
        <div class="acard">
          <div class="acard-h"><span class="acard-t">Tous les pronostics</span>
            <select class="finput" style="width:auto;padding:5px 10px;font-size:12px" onchange="renderPronos(this.value)">
              <option value="all">Tous</option><option value="foot">⚽ Foot</option><option value="tennis">🎾 Tennis</option><option value="autres">🏅 Autres</option>
            </select>
          </div>
          <div style="padding:0"><table class="ptable"><thead><tr><th>Match</th><th>Sport</th><th>Type</th><th>Cote</th><th>Tip</th><th>Actions</th></tr></thead><tbody id="prono-tbody"></tbody></table></div>
        </div>
      </div>

      <div class="apage" id="apage-membres">
        <div class="atitle">Membres inscrits</div>
        <div class="stat-row">
          <div class="scard"><div class="sv" id="m-total">—</div><div class="sl">Total membres</div></div>
          <div class="scard"><div class="sv" id="m-vip">—</div><div class="sl">Membres VIP</div></div>
        </div>
        <div class="acard">
          <div class="acard-h">
            <span class="acard-t">Liste des membres (Firebase)</span>
            <button class="abtn abtn-ghost abtn-sm" onclick="loadMembres()">🔄 Actualiser</button>
          </div>
          <div style="padding:0"><table class="ptable"><thead><tr><th>Nom</th><th>Email</th><th>Plan</th><th>Date d'inscription</th></tr></thead><tbody id="membres-tbody"><tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px">Clique sur Actualiser pour charger depuis Firebase</td></tr></tbody></table></div>
        </div>
      </div>

      <div class="apage" id="apage-reglages">
        <div class="atitle">Réglages</div>
        <div class="alert-ok" id="alert-save">✅ Modifications enregistrées !</div>
        <div class="acard">
          <div class="acard-h"><span class="acard-t">📊 Stats de la page d'accueil</span></div>
          <div class="acard-b">
            <div class="fg2">
              <div class="fg"><div class="flabel">Pronos réussis</div><input class="finput" type="text" id="cfg-taux" placeholder="Ex : 42" /></div>
              <div class="fg"><div class="flabel">Membres actifs</div><input class="finput" type="text" id="cfg-mbstat" placeholder="Ex : 1 240" /></div>
              <div class="fg"><div class="flabel">Années d'expérience</div><input class="finput" type="text" id="cfg-exp" placeholder="Ex : 5 ans" /></div>
            </div>
            <button class="abtn abtn-green" style="margin-top:14px" onclick="saveStats()">Mettre à jour les stats</button>
          </div>
        </div>
        <div class="acard">
          <div class="acard-h"><span class="acard-t">📋 Informations légales</span></div>
          <div class="acard-b">
            <div class="fg2">
              <div class="fg"><div class="flabel">Prénom et nom</div><input class="finput" type="text" id="cfg-nom" placeholder="Ex : Marie Dupont" /></div>
              <div class="fg"><div class="flabel">Email de contact</div><input class="finput" type="email" id="cfg-email" placeholder="contact@pronoskillz.fr" /></div>
              <div class="fg full"><div class="flabel">Adresse postale</div><input class="finput" type="text" id="cfg-adresse" placeholder="Ex : 12 rue de la Paix, 75001 Paris" /></div>
              <div class="fg"><div class="flabel">Numéro SIRET</div><input class="finput" type="text" id="cfg-siret" placeholder="Ex : 123 456 789 00012" /></div>
              <div class="fg"><div class="flabel">Hébergeur</div><input class="finput" type="text" id="cfg-heb" placeholder="Ex : Netlify" /></div>
            </div>
            <button class="abtn abtn-green" style="margin-top:14px" onclick="saveLegalInfo()">Enregistrer</button>
          </div>
        </div>
        <div class="acard">
          <div class="acard-h"><span class="acard-t">🔐 Accès administrateur</span></div>
          <div class="acard-b">
            <div class="fg2">
              <div class="fg"><div class="flabel">Identifiant</div><input class="finput" type="text" id="cfg-auser" value="admin" /></div>
              <div class="fg"><div class="flabel">Nouveau mot de passe</div><input class="finput" type="password" id="cfg-apass" placeholder="Laisser vide = pas de changement" /></div>
            </div>
            <button class="abtn abtn-ghost" style="margin-top:14px" onclick="saveAdminCreds()">Mettre à jour</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
var PRONOS=[];
var nextId=11;
var ADMIN_USER='admin',ADMIN_PASS='prono2026';
var currentUser=null;

// Attendre que Firebase soit prêt
document.addEventListener('firebaseReady', function(){
  loadConfig();
  loadPronos();
});
// Si Firebase est déjà prêt (rechargement)
if(window.fbReady){ loadConfig(); loadPronos(); }

var sEmoji={foot:'⚽',tennis:'🎾',autres:'🏅'};
var sLabel={foot:'Foot',tennis:'Tennis',autres:'Autres'};
var tLabel={'safe':'Cote Safe','hot':'Grosse Cote','vip-safe':'Cote Safe VIP','vip-hot':'Grosse Cote VIP'};
var tClass={'safe':'b-safe','hot':'b-hot','vip-safe':'b-vip','vip-hot':'b-vip'};
var aClass={'safe':'accent-safe','hot':'accent-hot','vip-safe':'accent-vip','vip-hot':'accent-vip'};

function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');}
function showPublicPage(id){document.querySelectorAll('#site-public>.page').forEach(p=>p.classList.remove('active'));document.getElementById('pub-'+id).classList.add('active');window.scrollTo(0,0);}
function goAdmin(){showPage('admin-login');}
function switchSportTab(sport){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.sport-page').forEach(p=>p.classList.remove('active'));
  var tabEl=document.getElementById('tab-'+sport);
  var spEl=document.getElementById('sp-'+sport);
  if(tabEl) tabEl.classList.add('active');
  if(spEl) spEl.classList.add('active');
  try{localStorage.setItem('lastSport', sport);}catch(e){}
}

function loadLastSport(){
  try{
    var last = localStorage.getItem('lastSport') || 'foot';
    var validSports = ['foot','tennis','autres'];
    if(!validSports.includes(last)) last = 'foot';
    var tabEl = document.getElementById('tab-'+last);
    var spEl = document.getElementById('sp-'+last);
    if(tabEl && spEl) switchSportTab(last);
    else switchSportTab('foot');
  }catch(e){ switchSportTab('foot'); }
}
function renderPublicSport(sport,cid){
  var isVip=currentUser!==null;
  var safe=PRONOS.filter(p=>p.sport===sport&&p.type==='safe');
  var hot=PRONOS.filter(p=>p.sport===sport&&p.type==='hot');
  var vipSafe=PRONOS.filter(p=>p.sport===sport&&p.type==='vip-safe');
  var vipHot=PRONOS.filter(p=>p.sport===sport&&p.type==='vip-hot');
  var vipAll=vipSafe.concat(vipHot);
  var em=sEmoji[sport];
  var html='';
  function card(p){
    var tipHtml='';
    if(p.conseil||p.analyse||p.confiance){
      tipHtml='<div class="prono-tip">';
      if(p.conseil)tipHtml+='<div class="prono-tip-row"><span class="prono-tip-label">Conseil</span><span class="prono-tip-conseil">'+p.conseil+'</span></div>';
      if(p.analyse)tipHtml+='<div class="prono-tip-row"><span class="prono-tip-label">Analyse</span><span class="prono-tip-text">'+p.analyse+'</span></div>';
      if(p.confiance)tipHtml+='<div class="prono-tip-confiance"><span class="prono-tip-confiance-label">Confiance</span><span class="prono-tip-conf-val">'+p.confiance+'</span></div>';
      tipHtml+='</div>';
    }else if(p.tip){
      tipHtml='<div class="prono-tip"><div class="prono-tip-row"><span class="prono-tip-text">'+p.tip+'</span></div></div>';
    }
    return '<div class="prono"><div class="prono-accent '+aClass[p.type]+'"></div><div class="prono-body"><div class="sport-icon">'+em+'</div><div class="prono-teams"><div class="prono-match">'+p.match+'</div><div class="prono-meta">'+p.meta+'</div>'+tipHtml+'</div><div class="prono-right"><span class="badge '+tClass[p.type]+'">'+tLabel[p.type]+'</span><div class="cote-val">'+p.cote+'</div><div class="cote-lbl">cote</div></div></div></div>';
  }
  if(safe.length||hot.length){
    html+='<div class="section-header"><div class="section-pill pill-public">🌐 Public</div><div class="section-line"></div></div>';
    if(safe.length)html+='<div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">✅ Cotes Safe</div><div class="pronostics">'+safe.map(card).join('')+'</div>';
    if(hot.length)html+='<div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px">🔥 Grosses Cotes</div><div class="pronostics">'+hot.map(card).join('')+'</div>';
  }
  if(vipAll.length){
    html+='<div class="section-header" style="margin-top:24px"><div class="section-pill pill-vip">⭐ VIP</div><div class="section-line"></div></div>';
    if(isVip){
      if(vipSafe.length)html+='<div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">✅ Cotes Safe VIP</div><div class="pronostics">'+vipSafe.map(card).join('')+'</div>';
      if(vipHot.length)html+='<div style="font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px">🔥 Grosses Cotes VIP</div><div class="pronostics">'+vipHot.map(card).join('')+'</div>';
    }else{
      html+='<div class="pronostics lock-overlay">'+vipAll.map(card).join('')+'</div>';
      html+='<div class="lock-banner"><h3>Accès VIP Gratuit</h3><p>Inscris-toi gratuitement pour voir tous les pronos VIP.</p><button class="btn-outline" onclick="showPublicPage(\'register\')">Créer mon compte ⭐</button></div>';
    }
  }
  if(!safe.length&&!hot.length&&!vipAll.length)html='<div style="text-align:center;padding:40px;color:var(--muted)">Aucun pronostic pour ce sport.</div>';
  document.getElementById(cid).innerHTML=html;
}

async function loadConfig(){
  if(!window.fbReady){return;}
  try{
    // Charger identifiants admin
    var snapAdmin=await window.fbGetDoc(window.fbDoc(window.fbDb,'config','admin'));
    if(snapAdmin.exists()){
      var da=snapAdmin.data();
      if(da.user)ADMIN_USER=da.user;
      if(da.pass)ADMIN_PASS=atob(da.pass);
    }
    var snap=await window.fbGetDoc(window.fbDoc(window.fbDb,'config','stats'));
    if(snap.exists()){
      var d=snap.data();
      if(d.taux)document.getElementById('stat-taux').textContent=d.taux;
      if(d.membres)document.getElementById('stat-membres').textContent=d.membres;
      if(d.exp)document.getElementById('stat-exp').textContent=d.exp;
    }
    var snap2=await window.fbGetDoc(window.fbDoc(window.fbDb,'config','legal'));
    if(snap2.exists()){
      var d2=snap2.data();
      if(d2.nom){['legal-nom','footer-nom'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=d2.nom;});}
      if(d2.email){['legal-email','rgpd-email'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=d2.email;});}
      if(d2.adresse){var el=document.getElementById('legal-adresse');if(el)el.textContent=d2.adresse;}
      if(d2.siret){['legal-siret','footer-siret'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=d2.siret;});}
      if(d2.heb){var el=document.getElementById('legal-heb');if(el)el.textContent=d2.heb;}
    }
  }catch(e){console.log('Config erreur:',e.message);}
}

async function loadPronos(){
  if(!window.fbReady){return;}
  try{
    var snap=await window.fbGetDocs(window.fbCol(window.fbDb,'pronos'));
    PRONOS=[];
    snap.forEach(function(d){PRONOS.push(Object.assign({},d.data(),{fbId:d.id}));});
    PRONOS.sort(function(a,b){return (b.createdAt||'').localeCompare(a.createdAt||'');});
    renderAllSports();
    loadLastSport();
  }catch(e){console.log('Pronos erreur:',e.message);}
}

async function savePronoFirebase(){
  var m=document.getElementById('f-match').value.trim();
  var c=document.getElementById('f-cote').value.trim();
  if(!m||!c){alert('Match et cote obligatoires !');return;}
  if(!window.fbReady){alert('Firebase non connecte');return;}
  try{
    var prono={match:m,sport:document.getElementById('f-sport').value,meta:document.getElementById('f-meta').value,type:document.getElementById('f-type').value,cote:parseFloat(c).toFixed(2),conseil:document.getElementById('f-conseil').value,analyse:document.getElementById('f-analyse').value,confiance:document.getElementById('f-confiance').value,createdAt:new Date().toISOString()};
    await window.fbAddDoc(window.fbCol(window.fbDb,'pronos'),prono);
    clearForm();
    await loadPronos();
    renderPronos('all');
    var a=document.getElementById('alert-add');a.classList.add('show');setTimeout(function(){a.classList.remove('show');},3000);
  }catch(e){alert('Erreur : '+e.message);}
}

async function saveConfigFirebase(type){
  if(!window.fbReady){alert('Firebase non connecte');return;}
  try{
    if(type==='stats'){
      var data={taux:document.getElementById('cfg-taux').value,membres:document.getElementById('cfg-mbstat').value,exp:document.getElementById('cfg-exp').value};
      await window.fbSetDoc(window.fbDoc(window.fbDb,'config','stats'),data);
      if(data.taux)document.getElementById('stat-taux').textContent=data.taux;
      if(data.unites)document.getElementById('stat-unites').textContent=data.unites;
      if(data.membres)document.getElementById('stat-membres').textContent=data.membres;
      if(data.exp)document.getElementById('stat-exp').textContent=data.exp;
    }
    if(type==='legal'){
      var data={nom:document.getElementById('cfg-nom').value,email:document.getElementById('cfg-email').value,adresse:document.getElementById('cfg-adresse').value,siret:document.getElementById('cfg-siret').value,heb:document.getElementById('cfg-heb').value};
      await window.fbSetDoc(window.fbDoc(window.fbDb,'config','legal'),data);
      if(data.nom){['legal-nom','footer-nom'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=data.nom;});}
      if(data.email){['legal-email','rgpd-email'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=data.email;});}
      if(data.adresse){var el=document.getElementById('legal-adresse');if(el)el.textContent=data.adresse;}
      if(data.siret){['legal-siret','footer-siret'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=data.siret;});}
      if(data.heb){var el=document.getElementById('legal-heb');if(el)el.textContent=data.heb;}
    }
    var a=document.getElementById('alert-save');a.classList.add('show');setTimeout(function(){a.classList.remove('show');},3000);
  }catch(e){alert('Erreur : '+e.message);}
}

function renderAllSports(){
  renderPublicSport('foot','foot-content');
  renderPublicSport('tennis','tennis-content');
  renderPublicSport('autres','autres-content');
}

// ===== FIREBASE INSCRIPTION =====
async function doRegister(){
  var nom=document.getElementById('r-nom').value.trim();
  var email=document.getElementById('r-email').value.trim();
  var pass=document.getElementById('r-pass').value;
  var pass2=document.getElementById('r-pass2').value;
  var err=document.getElementById('reg-err');
  err.style.display='none';
  if(!nom||!email||!pass||!pass2){err.textContent='Remplis tous les champs.';err.style.display='block';return;}
  if(!document.getElementById('ck-age').checked||!document.getElementById('ck-cgu').checked||!document.getElementById('ck-risque').checked){err.textContent='Coche les 3 cases obligatoires.';err.style.display='block';return;}
  if(pass!==pass2){err.textContent='Les mots de passe ne correspondent pas.';err.style.display='block';return;}
  if(pass.length<8){err.textContent='Mot de passe trop court (8 min).';err.style.display='block';return;}
  var btn=document.getElementById('btn-register');
  btn.innerHTML='<span class="spinner"></span>Inscription en cours...';
  btn.disabled=true;
  try{
    if(!window.fbReady)throw new Error('Firebase non connecté');
    // Vérifie si email déjà utilisé
    var q=window.fbQuery(window.fbCollection(window.fbDb,'membres'),window.fbWhere('email','==',email));
    var snap=await window.fbGetDocs(q);
    if(!snap.empty){err.textContent='Cet email est déjà inscrit.';err.style.display='block';btn.innerHTML='Créer mon compte VIP ⭐';btn.disabled=false;return;}
    // Sauvegarde dans Firebase
    await window.fbAddDoc(window.fbCollection(window.fbDb,'membres'),{
      nom:nom,email:email,
      pass:btoa(pass), // encodage basique
      plan:'VIP',
      date:new Date().toLocaleDateString('fr-FR'),
      createdAt:new Date().toISOString()
    });
    currentUser={nom:nom,email:email};
    updateNavMembre();
    renderAllSports();
    showPublicPage('home');
    document.getElementById('membre-welcome').style.display='block';
    document.getElementById('welcome-prenom').textContent=nom.split(' ')[0];
  }catch(e){
    err.textContent='Erreur : '+e.message;err.style.display='block';
    btn.innerHTML='Créer mon compte VIP ⭐';btn.disabled=false;
  }
}

// ===== FIREBASE CONNEXION =====
async function doLogin(){
  var email=document.getElementById('l-email').value.trim();
  var pass=document.getElementById('l-pass').value;
  var err=document.getElementById('login-err');
  err.style.display='none';
  var btn=document.getElementById('btn-login');
  btn.innerHTML='<span class="spinner"></span>Connexion...';btn.disabled=true;
  try{
    if(!window.fbReady)throw new Error('Firebase non connecté');
    var q=window.fbQuery(window.fbCollection(window.fbDb,'membres'),window.fbWhere('email','==',email));
    var snap=await window.fbGetDocs(q);
    if(snap.empty){err.textContent='Email ou mot de passe incorrect.';err.style.display='block';btn.innerHTML='Se connecter';btn.disabled=false;return;}
    var userData=snap.docs[0].data();
    if(atob(userData.pass)!==pass){err.textContent='Email ou mot de passe incorrect.';err.style.display='block';btn.innerHTML='Se connecter';btn.disabled=false;return;}
    currentUser={nom:userData.nom,email:userData.email};
    updateNavMembre();renderAllSports();
    showPublicPage('home');
    document.getElementById('membre-welcome').style.display='block';
    document.getElementById('welcome-prenom').textContent=userData.nom.split(' ')[0];
  }catch(e){
    err.textContent='Erreur : '+e.message;err.style.display='block';
    btn.innerHTML='Se connecter';btn.disabled=false;
  }
}

function deconnexion(){currentUser=null;updateNavMembre();renderAllSports();document.getElementById('membre-welcome').style.display='none';}
function updateNavMembre(){
  if(currentUser){
    document.getElementById('nav-guest').style.display='none';
    document.getElementById('nav-membre').style.display='block';
    document.getElementById('nav-prenom').textContent=currentUser.nom.split(' ')[0];
    document.getElementById('hero-vip-btn').style.display='none';
  }else{
    document.getElementById('nav-guest').style.display='flex';
    document.getElementById('nav-membre').style.display='none';
    document.getElementById('hero-vip-btn').style.display='inline-flex';
  }
}

// ===== FIREBASE CHARGER MEMBRES (admin) =====
async function loadMembres(){
  var tbody=document.getElementById('membres-tbody');
  tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px"><span class="spinner" style="border-color:rgba(138,172,134,.3);border-top-color:var(--muted)"></span> Chargement...</td></tr>';
  try{
    if(!window.fbReady)throw new Error('Firebase non connecté');
    var snap=await window.fbGetDocs(window.fbCollection(window.fbDb,'membres'));
    var membres=[];
    snap.forEach(doc=>membres.push(doc.data()));
    document.getElementById('m-total').textContent=membres.length;
    document.getElementById('m-vip').textContent=membres.length;
    document.getElementById('dash-membres').textContent=membres.length;
    var html=membres.map(m=>'<tr><td>'+m.nom+'</td><td style="color:var(--muted)">'+m.email+'</td><td><span class="badge b-vip">VIP</span></td><td style="color:var(--muted)">'+m.date+'</td></tr>').join('');
    tbody.innerHTML=html||'<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px">Aucun membre inscrit</td></tr>';
  }catch(e){
    tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--red);padding:20px">Erreur Firebase : '+e.message+'</td></tr>';
  }
}


function activerApercuVIP(){
  currentUser={nom:'Admin',email:'admin@pronoskillz.fr'};
  updateNavMembre();
  renderAllSports();
  showPage('site-public');
  showPublicPage('home');
  document.getElementById('membre-welcome').style.display='block';
  document.getElementById('welcome-prenom').textContent='Admin - Mode Apercu';
}

function doAdminLogin(){
  var u=document.getElementById('al-user').value;
  var p=document.getElementById('al-pass').value;
  if(u===ADMIN_USER&&p===ADMIN_PASS){showPage('admin-panel');updateDashboard();}
  else{document.getElementById('al-err').style.display='block';}
}
function adminLogout(){showPage('admin-login');document.getElementById('al-user').value='';document.getElementById('al-pass').value='';document.getElementById('al-err').style.display='none';}
function showAPage(id,el){
  document.querySelectorAll('.apage').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.si').forEach(s=>s.classList.remove('active'));
  document.getElementById('apage-'+id).classList.add('active');
  if(el)el.classList.add('active');
  if(id==='list-prono')renderPronos('all');
  if(id==='dashboard')updateDashboard();
  if(id==='membres')loadMembres();
}
function updateDashboard(){
  document.getElementById('dash-total').textContent=PRONOS.length;
  document.getElementById('dash-vip-count').textContent=PRONOS.filter(p=>p.type==='vip').length;
  var rows=PRONOS.slice(0,5).map(p=>'<tr><td style="font-weight:600">'+p.match+'</td><td>'+sEmoji[p.sport]+' '+sLabel[p.sport]+'</td><td><span class="badge '+tClass[p.type]+'">'+tLabel[p.type]+'</span></td><td><span class="cote-chip">'+p.cote+'</span></td></tr>').join('');
  document.getElementById('dash-tbody').innerHTML=rows||'<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:16px">Aucun prono</td></tr>';
}
function renderPronos(filter){
  var list=filter==='all'?PRONOS:PRONOS.filter(function(p){return p.sport===filter;});
  var tbody=document.getElementById('prono-tbody');
  if(!list.length){tbody.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:20px">Aucun pronostic</td></tr>';return;}
  tbody.innerHTML='';
  list.forEach(function(p){
    var tr=document.createElement('tr');
    tr.innerHTML='<td style="font-weight:600">'+p.match+'</td><td>'+sEmoji[p.sport]+' '+sLabel[p.sport]+'</td><td><span class="badge '+tClass[p.type]+'">'+tLabel[p.type]+'</span></td><td><span class="cote-chip">'+p.cote+'</span></td><td style="color:var(--muted);font-size:12px">'+p.tip+'</td><td></td>';
    var btn=document.createElement('button');
    btn.className='abtn abtn-danger abtn-sm';
    btn.textContent='Suppr.';
    btn.setAttribute('data-fbid', p.fbId);
    btn.addEventListener('click', function(){deleteProno(this.getAttribute('data-fbid'));});
    tr.lastChild.appendChild(document.createElement('div')).appendChild(btn);
    tbody.appendChild(tr);
  });
}
function saveProno(){
  var m=document.getElementById('f-match').value.trim();
  var c=document.getElementById('f-cote').value.trim();
  if(!m||!c){alert('Match et cote obligatoires !');return;}
  PRONOS.unshift({id:nextId++,match:m,sport:document.getElementById('f-sport').value,meta:document.getElementById('f-meta').value,type:document.getElementById('f-type').value,cote:parseFloat(c).toFixed(2),tip:document.getElementById('f-tip').value});
  clearForm();renderAllSports();
  var a=document.getElementById('alert-add');a.classList.add('show');setTimeout(()=>a.classList.remove('show'),3000);
}
function clearForm(){['f-match','f-meta','f-cote','f-conseil','f-analyse'].forEach(id=>document.getElementById(id).value='');document.getElementById('f-confiance').value='3% BK';}
async function deleteProno(fbId){
  if(!confirm('Supprimer ce pronostic ?'))return;
  try{
    await window.fbDeleteDoc(window.fbDoc(window.fbDb,'pronos',fbId));
    await loadPronos();
    renderPronos('all');
  }catch(e){alert('Erreur suppression : '+e.message);}
}
function editProno(id){
  var p=PRONOS.find(x=>x.id===id);if(!p)return;
  document.getElementById('f-match').value=p.match;document.getElementById('f-meta').value=p.meta;
  document.getElementById('f-cote').value=p.cote;document.getElementById('f-tip').value=p.tip;
  document.getElementById('f-sport').value=p.sport;document.getElementById('f-type').value=p.type;
  PRONOS.splice(PRONOS.findIndex(x=>x.id===id),1);
  showAPage('add-prono',document.querySelectorAll('.si')[1]);
}
async function saveStats(){
  if(!window.fbReady){alert('Firebase non connecte');return;}
  try{
    var data={
      taux:document.getElementById('cfg-taux').value.trim(),
      membres:document.getElementById('cfg-mbstat').value.trim(),
      exp:document.getElementById('cfg-exp').value.trim()
    };
    await window.fbSetDoc(window.fbDoc(window.fbDb,'config','stats'),data,{merge:true});
    if(data.taux)document.getElementById('stat-taux').textContent=data.taux;
    if(data.unites)document.getElementById('stat-unites').textContent=data.unites;
    if(data.membres)document.getElementById('stat-membres').textContent=data.membres;
    if(data.exp)document.getElementById('stat-exp').textContent=data.exp;
    var a=document.getElementById('alert-save');a.classList.add('show');setTimeout(function(){a.classList.remove('show');},3000);
  }catch(e){alert('Erreur : '+e.message);}
}
async function saveLegalInfo(){
  if(!window.fbReady){alert('Firebase non connecte');return;}
  try{
    var data={
      nom:document.getElementById('cfg-nom').value.trim(),
      email:document.getElementById('cfg-email').value.trim(),
      adresse:document.getElementById('cfg-adresse').value.trim(),
      siret:document.getElementById('cfg-siret').value.trim(),
      heb:document.getElementById('cfg-heb').value.trim()
    };
    await window.fbSetDoc(window.fbDoc(window.fbDb,'config','legal'),data,{merge:true});
    var map={nom:['legal-nom','footer-nom'],email:['legal-email','rgpd-email'],adresse:['legal-adresse'],siret:['legal-siret','footer-siret'],heb:['legal-heb']};
    Object.keys(map).forEach(function(k){
      if(data[k])map[k].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=data[k];});
    });
    var a=document.getElementById('alert-save');a.classList.add('show');setTimeout(function(){a.classList.remove('show');},3000);
  }catch(e){alert('Erreur : '+e.message);}
}
async function saveAdminCreds(){
  var u=document.getElementById('cfg-auser').value.trim();
  var p=document.getElementById('cfg-apass').value;
  if(!u){alert('Identifiant obligatoire');return;}
  if(!window.fbReady){alert('Firebase non connecte');return;}
  try{
    var data={user:u};
    if(p)data.pass=btoa(p);
    await window.fbSetDoc(window.fbDoc(window.fbDb,'config','admin'),data,{merge:true});
    if(u)ADMIN_USER=u;
    if(p)ADMIN_PASS=p;
    var a=document.getElementById('alert-save');
    a.classList.add('show');
    setTimeout(function(){a.classList.remove('show');},3000);
  }catch(e){alert('Erreur : '+e.message);}
}
renderAllSports();
</script>
<script>
if('serviceWorker' in navigator){
  window.addEventListener('load', function(){
    navigator.serviceWorker.register('sw.js')
      .then(function(reg){ console.log('SW enregistré'); })
      .catch(function(err){ console.log('SW erreur:', err); });
  });
}
// Bouton installation PWA
var deferredPrompt;
window.addEventListener('beforeinstallprompt', function(e){
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById('pwa-banner').style.display = 'flex';
});
function installPWA(){
  if(deferredPrompt){
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(function(result){
      if(result.outcome === 'accepted'){
        document.getElementById('pwa-banner').style.display = 'none';
      }
      deferredPrompt = null;
    });
  }
}
</script>
</body>
</html>
