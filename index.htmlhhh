<!-- FIREBASE SDK -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, getDoc, doc, setDoc, deleteDoc, query, where, orderBy } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyARWdQ3DVgWDeM5Ueb7dARvb6-0zoAFXh0",
  authDomain: "pronoskillz.firebaseapp.com",
  databaseURL: "https://pronoskillz-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "pronoskillz",
  storageBucket: "pronoskillz.firebasestorage.app",
  messagingSenderId: "481278521158",
  appId: "1:481278521158:web:383fef4c2d76128922bf47"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

// Expose DB functions globally
window.fbDb = db;
window.fbCol = collection;
window.fbCollection = collection;
window.fbAddDoc = addDoc;
window.fbGetDocs = getDocs;
window.fbGetDoc = getDoc;
window.fbDoc = doc;
window.fbSetDoc = setDoc;
window.fbDeleteDoc = deleteDoc;
window.fbQuery = query;
window.fbWhere = where;
window.fbOrderBy = orderBy;
window.fbReady = true;
console.log('Firebase connecte!');
// Attendre que le DOM soit prêt avant de mettre à jour l'indicateur
function onFirebaseReady(){
  var ind=document.getElementById('fb-indicator');
  if(ind){ind.style.background='rgba(26,122,60,.2)';ind.style.color='#6ee89a';ind.style.borderColor='rgba(26,122,60,.35)';ind.textContent='● Firebase connecté';}
  document.dispatchEvent(new Event('firebaseReady'));
}
if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded', onFirebaseReady);
}else{
  onFirebaseReady();
}
</script>

