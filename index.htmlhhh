<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PronoSkillz — Pronostics Sportifs</title>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-2C2F5863GY"></script>
<script>
window.dataLayer=window.dataLayer||[];
function gtag(){dataLayer.push(arguments);}
gtag("js",new Date());
gtag("config","G-2C2F5863GY");
</script>
<meta name="theme-color" content="#0d1a12">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="PronoSkillz">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--green:#1a7a3c;--gl:#22a050;--gd:#104d26;--gold:#c9a227;--gold-l:#f0c040;--gold-d:#8a6e10;--bg:#0d1a12;--s1:#142010;--s2:#1c2e18;--text:#f0f4ef;--muted:#8aac86;--border:#2a4028;--red:#c05555;--red-bg:rgba(192,85,85,.15)}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Barlow',sans-serif;font-size:15px;line-height:1.6}
.page{display:none}.page.active{display:block}
#main-nav{background:var(--s1);border-bottom:2px solid var(--gold-d);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:60px;position:sticky;top:0;z-index:100}
.logo{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:2px;color:var(--gold-l);cursor:pointer}
.logo span{color:var(--gl)}
.nav-links{display:flex;gap:16px;align-items:center}
.nav-links a{color:var(--muted);text-decoration:none;font-size:14px;cursor:pointer}
.nav-links a:hover{color:var(--text)}
.btn-vip{background:var(--gold);color:#000;font-weight:600;font-size:13px;padding:8px 18px;border-radius:7px;border:none;cursor:pointer;font-family:inherit}
.btn-vip:hover{background:var(--gold-l)}
.btn-login{background:transparent;color:var(--muted);font-size:13px;padding:8px 14px;border-radius:7px;border:1px solid var(--border);cursor:pointer;font-family:inherit}
.btn-login:hover{color:var(--text);border-color:var(--muted)}
.hero{background:var(--gd);padding:64px 24px 48px;text-align:center;border-bottom:1px solid var(--border);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% -10%,rgba(201,162,39,.2) 0%,transparent 60%)}
.hero h1{font-family:'Bebas Neue',sans-serif;font-size:58px;letter-spacing:3px;line-height:1;margin-bottom:12px;position:relative}
.hero h1 em{color:var(--gold-l);font-style:normal}
.hero p{color:var(--muted);font-size:16px;max-width:440px;margin:0 auto 28px;position:relative}
.hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative}
.btn-main{background:var(--gl);color:#fff;padding:12px 26px;border-radius:8px;border:none;cursor:pointer;font-family:inherit;font-weight:600;font-size:15px}
.btn-main:hover{background:var(--green)}
.btn-outline{background:transparent;color:var(--gold-l);padding:12px 26px;border-radius:8px;border:1px solid var(--gold);cursor:pointer;font-family:inherit;font-weight:600;font-size:15px}
.btn-outline:hover{background:rgba(201,162,39,.1)}
.stats-bar{display:flex;justify-content:center;background:var(--s2);border-bottom:1px solid var(--border);flex-wrap:wrap}
.stat{text-align:center;padding:18px 36px;border-right:1px solid var(--border)}
.stat:last-child{border-right:none}
.stat-val{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--gold-l);letter-spacing:1px}
.stat-lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
.tabs-wrapper{background:var(--s2);border-bottom:2px solid var(--border);padding:16px 16px 0;overflow-x:auto}
.tabs{display:flex;gap:8px;min-width:max-content}
.tab{padding:12px 22px;font-size:14px;font-weight:600;font-family:inherit;color:var(--muted);cursor:pointer;background:var(--s1);border:1px solid var(--border);border-bottom:3px solid transparent;border-radius:10px 10px 0 0;transition:all .2s;display:flex;align-items:center;gap:8px;white-space:nowrap}
.tab-emoji{font-size:18px}
.tab-label{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1px}
.tab.active{background:var(--bg);color:var(--gold-l);border-color:var(--gold-d);border-bottom-color:var(--bg);margin-bottom:-2px}
.tab:hover:not(.active){color:var(--text);background:rgba(255,255,255,.04)}
.content{padding:24px;max-width:760px;margin:0 auto}
.sport-page{display:none}.sport-page.active{display:block}
.section-header{display:flex;align-items:center;gap:12px;margin:28px 0 14px}
.section-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 16px;border-radius:30px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;white-space:nowrap}
.pill-hot{background:rgba(201,162,39,.18);color:var(--gold-l);border:1px solid rgba(201,162,39,.4)}
.pill-safe{background:rgba(26,122,60,.2);color:#6ee89a;border:1px solid rgba(26,122,60,.45)}
.pill-vip{background:rgba(192,85,85,.18);color:#f08080;border:1px solid rgba(192,85,85,.35)}
.section-line{flex:1;height:1px;background:var(--border)}
.pronostics{display:flex;flex-direction:column;gap:10px;margin-bottom:8px}
.prono{background:var(--s1);border:1px solid var(--border);border-radius:12px;overflow:hidden;display:flex;transition:border-color .2s,transform .15s}
.prono:hover{border-color:var(--gl);transform:translateY(-1px)}
.prono-accent{width:5px;flex-shrink:0}
.accent-hot{background:var(--gold)}.accent-safe{background:var(--gl)}.accent-vip{background:#c05555}
.prono-body{flex:1;padding:14px 16px;display:flex;align-items:center;gap:12px}
.sport-icon{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;background:var(--s2);border:1px solid var(--border)}
.prono-teams{flex:1}
.prono-match{font-size:15px;font-weight:600;color:var(--text)}
.prono-meta{font-size:12px;color:var(--muted);margin-top:2px}
.prono-tip{margin-top:10px;display:flex;flex-direction:column;gap:10px}
.prono-tip-row{display:flex;flex-direction:column;gap:3px}
.prono-tip-label{font-weight:700;color:var(--gold-l);font-size:10px;text-transform:uppercase;letter-spacing:.6px}
.prono-tip-text{color:var(--text);line-height:1.5;font-size:13px}.prono-tip-conseil{font-size:17px;font-weight:700;color:#6ee89a;line-height:1.3}
.prono-tip-confiance{display:flex;flex-direction:column;gap:3px}
.prono-tip-confiance-label{font-weight:700;color:var(--gold-l);font-size:10px;text-transform:uppercase;letter-spacing:.6px}
.prono-tip-conf-val{font-size:13px;color:#6ee89a;font-weight:700}
.prono-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.badge{font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px;white-space:nowrap;text-transform:uppercase;letter-spacing:.4px}
.b-hot{background:rgba(201,162,39,.2);color:var(--gold-l);border:1px solid rgba(201,162,39,.35)}
.b-safe{background:rgba(26,122,60,.25);color:#6ee89a;border:1px solid rgba(26,122,60,.4)}
.b-vip{background:rgba(192,85,85,.2);color:#f08080;border:1px solid rgba(192,85,85,.3)}.pill-public{background:rgba(100,150,255,.18);color:#a0c4ff;border:1px solid rgba(100,150,255,.4)}
.cote-val{font-family:'Bebas Neue',sans-serif;font-size:30px;color:var(--gold-l);letter-spacing:1px;line-height:1}
.cote-lbl{font-size:10px;color:var(--muted);text-align:right}
.lock-overlay{filter:blur(4px);pointer-events:none;user-select:none;opacity:.5}
.lock-banner{background:var(--s2);border:1px solid var(--border);border-radius:12px;padding:22px;text-align:center;margin-top:4px;margin-bottom:8px}
.lock-banner h3{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;color:var(--gold-l);margin-bottom:8px}
.lock-banner p{font-size:13px;color:var(--muted);margin-bottom:16px}
.pricing-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.plan{background:var(--s1);border:1px solid var(--border);border-radius:14px;padding:24px;text-align:center;position:relative}
.plan.featured{border-color:var(--gold)}
.plan-tag{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--gold);color:#000;font-size:11px;font-weight:700;padding:3px 16px;border-radius:20px;white-space:nowrap}
.plan-name{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;color:var(--muted);margin-bottom:8px}
.plan-price{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--gold-l);letter-spacing:1px}
.plan-price span{font-size:15px;color:var(--muted);font-family:'Barlow',sans-serif;font-weight:400}
.plan-features{list-style:none;margin:16px 0;text-align:left}
.plan-features li{font-size:13px;color:var(--muted);padding:5px 0;display:flex;gap:8px;border-bottom:1px solid rgba(42,64,40,.4)}
.plan-features li:last-child{border-bottom:none}
.plan-features li::before{content:'✓';color:var(--gl);flex-shrink:0;font-weight:700}
.plan-features li.no::before{content:'✗';color:#c05555}
.plan-features li.no{color:#5a4a4a}
.auth-wrap{padding:32px 24px;max-width:460px;margin:0 auto}
.auth-box{background:var(--s1);border:1px solid var(--border);border-radius:16px;padding:32px}
.auth-title{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:2px;color:var(--gold-l);text-align:center;margin-bottom:4px}
.auth-sub{font-size:13px;color:var(--muted);text-align:center;margin-bottom:20px}
.vip-badge{display:flex;justify-content:center;margin-bottom:20px}
.vip-badge span{background:rgba(201,162,39,.15);color:var(--gold-l);border:1px solid rgba(201,162,39,.35);border-radius:20px;padding:5px 16px;font-size:12px;font-weight:600}
.fg{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.flabel{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
.finput{background:var(--s2);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:10px 14px;font-family:inherit;font-size:14px;width:100%;outline:none;transition:border-color .15s}
.finput:focus{border-color:var(--gold)}
.check-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;padding:11px;background:var(--s2);border-radius:8px;border:1px solid var(--border)}
.check-row input[type=checkbox]{width:16px;height:16px;margin-top:2px;flex-shrink:0;accent-color:var(--gl)}
.check-row span{font-size:12px;color:var(--muted);line-height:1.5}
.check-row a{color:var(--gold-l);text-decoration:none;cursor:pointer}
.btn-register{background:var(--gold);color:#000;font-weight:700;font-size:15px;padding:13px;border-radius:9px;border:none;cursor:pointer;font-family:inherit;width:100%;margin-top:8px}
.btn-register:hover{background:var(--gold-l)}
.auth-switch{font-size:12px;color:var(--muted);text-align:center;margin-top:14px}
.auth-switch a{color:var(--gold-l);text-decoration:none;cursor:pointer}
.err-msg{font-size:12px;color:var(--red);margin-top:8px;padding:8px 12px;background:var(--red-bg);border-radius:6px;display:none}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(0,0,0,.3);border-top-color:#000;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
.legal-wrap{padding:32px 24px;max-width:700px;margin:0 auto}
.legal-page-title{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:var(--text);margin-bottom:6px}
.legal-subtitle{font-size:13px;color:var(--muted);margin-bottom:28px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.legal-section{margin-bottom:28px}
.legal-section h2{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;color:var(--gold-l);margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border)}
.legal-section p,.legal-section li{font-size:13px;color:var(--muted);line-height:1.8;margin-bottom:6px}
.legal-section ul{padding-left:18px}
.legal-hl{background:rgba(201,162,39,.08);border-left:3px solid var(--gold);border-radius:0 7px 7px 0;padding:12px 16px;margin:12px 0}
.legal-hl p{color:var(--text);margin:0}
.editable{color:var(--gold-l);font-style:italic}
.admin-bar-top{background:var(--s1);border-bottom:2px solid var(--gold);padding:0 20px;height:52px;display:flex;align-items:center;justify-content:space-between}
.admin-logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;color:var(--gold-l)}
.admin-logo em{color:var(--gl);font-style:normal;font-size:13px;font-family:'Barlow',sans-serif;margin-left:8px;letter-spacing:0}
.admin-layout{display:flex;min-height:500px}
.sidebar{width:190px;background:var(--s1);border-right:1px solid var(--border);padding:14px 0;flex-shrink:0}
.si{padding:10px 16px;font-size:13px;color:var(--muted);cursor:pointer;display:flex;align-items:center;gap:8px;border-left:3px solid transparent;transition:all .15s}
.si:hover{color:var(--text);background:rgba(255,255,255,.03)}
.si.active{color:var(--gold-l);background:rgba(201,162,39,.08);border-left-color:var(--gold-l)}
.si-sep{height:1px;background:var(--border);margin:8px 12px}
.amain{flex:1;padding:20px;overflow-x:hidden}
.apage{display:none}.apage.active{display:block}
.atitle{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1.5px;color:var(--text);margin-bottom:20px}
.acard{background:var(--s1);border:1px solid var(--border);border-radius:10px;margin-bottom:16px;overflow:hidden}
.acard-h{padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.acard-t{font-size:14px;font-weight:600;color:var(--text)}
.acard-b{padding:16px}
.fg2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fg.full{grid-column:1/-1}
select.finput option{background:var(--s2)}
textarea.finput{resize:vertical;min-height:60px}
.abtn{padding:9px 18px;border-radius:7px;border:none;cursor:pointer;font-family:inherit;font-size:13px;font-weight:600;transition:all .15s}
.abtn-gold{background:var(--gold);color:#000}.abtn-gold:hover{background:var(--gold-l)}
.abtn-green{background:var(--gl);color:#fff}.abtn-green:hover{background:var(--green)}
.abtn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}.abtn-ghost:hover{color:var(--text)}
.abtn-danger{background:var(--red-bg);color:var(--red);border:1px solid rgba(192,85,85,.3)}
.abtn-sm{padding:5px 11px;font-size:12px}
.ptable{width:100%;border-collapse:collapse}
.ptable th{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;padding:8px 10px;text-align:left;border-bottom:1px solid var(--border)}
.ptable td{padding:10px;border-bottom:1px solid rgba(42,64,40,.4);vertical-align:middle;font-size:13px}
.ptable tr:last-child td{border-bottom:none}
.ptable tr:hover td{background:rgba(255,255,255,.02)}
.cote-chip{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--gold-l)}
.act-btns{display:flex;gap:6px}
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px;margin-bottom:20px}
.scard{background:var(--s1);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center}
.scard .sv{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--gold-l)}
.scard .sl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
.alert-ok{padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:14px;background:rgba(26,122,60,.2);color:#6ee89a;border:1px solid rgba(26,122,60,.35);display:none}
.alert-ok.show{display:block}
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:400px;padding:24px}
.login-box{background:var(--s1);border:1px solid var(--border);border-radius:16px;padding:36px;width:100%;max-width:340px;text-align:center}
.login-logo{font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:var(--gold-l);margin-bottom:2px}
.login-logo span{color:var(--gl)}
.login-sub{font-size:13px;color:var(--muted);margin-bottom:24px}
.login-err{font-size:12px;color:var(--red);margin-top:8px;display:none}
.login-hint{font-size:11px;color:var(--muted);margin-top:14px;opacity:.6}
footer{background:var(--s1);border-top:1px solid var(--border);padding:24px;text-align:center}
.footer-links{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-bottom:12px}
.footer-links a{color:var(--muted);text-decoration:none;font-size:13px;cursor:pointer}
.footer-links a:hover{color:var(--text)}
.footer-legal{font-size:12px;color:var(--muted);line-height:1.7}
.warning-bar{background:rgba(201,162,39,.08);border:1px solid rgba(201,162,39,.2);border-radius:8px;padding:10px 16px;text-align:center;font-size:12px;color:var(--muted);margin:0 24px 16px}
.warning-bar strong{color:var(--gold-l)}
.fb-status{font-size:11px;padding:4px 10px;border-radius:20px;display:inline-block;margin-bottom:8px}
.fb-ok{background:rgba(26,122,60,.2);color:#6ee89a;border:1px solid rgba(26,122,60,.35)}
.fb-err{background:var(--red-bg);color:var(--red);border:1px solid rgba(192,85,85,.3)}

@media(max-width:600px){
  #main-nav{padding:0 10px;height:56px}
  .logo{font-size:18px;flex-shrink:0}
  .nav-links{gap:5px}
  .nav-links a{font-size:11px}
  .btn-login{font-size:10px;padding:5px 8px}
  .btn-vip{font-size:10px;padding:5px 10px}
  .hero{padding:36px 16px 28px}
  .hero h1{font-size:36px;letter-spacing:1px}
  .hero p{font-size:13px}
  .btn-main,.btn-outline{padding:10px 16px;font-size:13px}
  .stats-bar{gap:0}
  .stat{padding:12px 16px}
  .stat-val{font-size:22px}
  .tabs-wrapper{padding:10px 10px 0}
  .tab{padding:10px 14px}
  .tab-label{font-size:14px}
  .content{padding:16px}
  .pricing-grid{grid-template-columns:1fr}
  .auth-wrap{padding:16px}
  .auth-box{padding:20px}
  .admin-layout{flex-direction:column}
  .sidebar{width:100%;display:flex;flex-wrap:wrap;padding:8px;gap:4px;border-right:none;border-bottom:1px solid var(--border)}
  .si{padding:8px 12px;border-left:none;border-radius:6px;font-size:12px}
  .si.active{border-left:none;background:rgba(201,162,39,.15)}
  .amain{padding:14px}
  .fg2{grid-template-columns:1fr}
  .ptable{font-size:11px}
  .ptable td,.ptable th{padding:6px 4px}
  .stat-row{grid-template-columns:1fr 1fr}
  .prono-body{flex-direction:column !important;gap:0 !important}
  .sport-icon{display:none !important}
  .prono-teams{width:100% !important;padding-bottom:10px}
  .prono-right{width:100% !important;flex-direction:row !important;justify-content:space-between !important;align-items:center !important;border-top:1px solid var(--border);padding-top:10px !important;flex-shrink:0}
  .cote-val{font-size:26px}
}
</style>
<!-- OneSignal -->
<script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
<script>
  window.OneSignalDeferred = window.OneSignalDeferred || [];
  OneSignalDeferred.push(async function(OneSignal) {
